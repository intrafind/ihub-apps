{
  "uid": "ihub-llm",
  "title": "iHub \u00b7 LLM calls",
  "description": "Model calls per provider, model and endpoint: latency, time to first chunk, errors, tokens, saturation.",
  "tags": [
    "ihub",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "query",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ihub_build_info, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Operation duration p95 by provider / model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_provider_name, gen_ai_request_model) (rate(gen_ai_client_inference_duration_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{gen_ai_provider_name}} {{gen_ai_request_model}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Time to first chunk p95 by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(gen_ai_client_inference_time_to_first_chunk_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{server_address}}"
        }
      ],
      "id": 3
    },
    {
      "type": "row",
      "title": "Errors and saturation",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Error ratio by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_provider_name) (rate(gen_ai_client_inference_duration_count{job=~\"$job\",error_type!=``}[5m])) / sum by (gen_ai_provider_name) (rate(gen_ai_client_inference_duration_count{job=~\"$job\"}[5m]))",
          "legendFormat": "{{gen_ai_provider_name}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Rate-limited calls (429) by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_provider_name) (rate(gen_ai_client_inference_duration_count{job=~\"$job\",error_type=`rate_limit_exceeded`}[5m]))",
          "legendFormat": "{{gen_ai_provider_name}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Calls in flight by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_provider_name) (ihub_llm_requests_inflight{job=~\"$job\"})",
          "legendFormat": "{{gen_ai_provider_name}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Calls waiting for a slot by model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (ihub_llm_requests_queued{job=~\"$job\"})",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Tokens",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Tokens per second by model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_input_tokens_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} input"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_output_tokens_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} output"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Prompt cache share of input tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_cache_read_input_tokens_total{job=~\"$job\"}[1h])) / sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_input_tokens_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "id": 11
    }
  ]
}
