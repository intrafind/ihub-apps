# npm 12 refuses dependencies fetched from a URL unless allowed (EALLOWREMOTE).
# `xlsx` is installed from the SheetJS CDN tarball (package.json), so allow
# remote tarballs that this package lists directly; transitive ones stay refused.
# Older npm versions ignore this setting.
allow-remote=root

# Ignore package versions published in the last 7 days when npm picks a version
# (npm 11.10+). Locked installs (`npm ci`) are not affected.
min-release-age=7
