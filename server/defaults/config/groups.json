        "apps": ["*"],
        "prompts": ["*"],
        "models": ["*"],
        "skills": ["*"],
        "integrations": ["*"],
        "adminAccess": false,
        "scheduledTasks": true,
        "projects": true,
        "projectSharing": true,
        "userApps": true,
        "userAppSharing": true
      },
      "mappings": []
