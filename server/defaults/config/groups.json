{
  "groups": {
    "admins": {
      "id": "admins",
      "name": "Admins",
      "description": "Full administrative access to all resources",
      "inherits": ["users"],
      "permissions": {
        "apps": ["*"],
        "prompts": ["*"],
        "models": ["*"],
        "skills": ["*"],
        "integrations": ["*"],
        "adminAccess": true,
        "scheduledTasks": true,
        "projects": true,
        "projectSharing": true,
        "userApps": true,
        "userAppSharing": true
      },
      "mappings": ["IT-Admin", "IT-Admins", "Platform-Admin", "Platform-Admins"]
    },
    "users": {
      "id": "users",
      "name": "Users",
      "description": "Standard user access to common applications and models",
      "inherits": ["authenticated"],
      "permissions": {
        "apps": ["*"],
        "prompts": ["*"],
        "models": ["*"],
        "skills": ["*"],
        "integrations": ["*"],
        "adminAccess": false,
        "scheduledTasks": true,
        "projects": true,
        "projectSharing": true,
        "userApps": true,
        "userAppSharing": true
      },
      "mappings": ["Employees", "Staff"]
    },
    "anonymous": {
      "id": "anonymous",
