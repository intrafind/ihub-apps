# ============================================================
# iHub Apps — Environment Variables (OPTIONAL)
# ============================================================
# You do NOT need this file to get started!
#
# Just run: npm run dev
# Then open http://localhost:3000 and configure API keys
# through the admin UI at /admin/providers.
#
# This file is only needed for:
#   - CI/CD pipelines or Docker deployments where you want
#     to inject keys via environment variables
#   - Overriding settings that aren't in the admin UI
# ============================================================

# --- API Keys (alternative to admin UI) ---
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#MISTRAL_API_KEY=

# --- Server (rarely needed) ---
#PORT=3000
#WORKERS=1
# libuv threadpool size (DNS lookups, file I/O, crypto). iHub sets 16 when unset;
# Node's own default is 4, which lets two hung DNS lookups stall all outbound calls.
#UV_THREADPOOL_SIZE=16
# Outbound DNS guard: max wait per hostname lookup and how long a failed lookup
# is remembered (fail fast). 0 disables the respective part.
#DNS_LOOKUP_TIMEOUT_MS=5000
#DNS_NEGATIVE_CACHE_MS=30000
# LLM transport ceilings. connect: how long a STREAMED call waits for the
# provider's response headers before failing as unreachable (queue time in the
# per-model throttle does not count; non-streamed calls answer to
# REQUEST_TIMEOUT instead). stream-idle: max gap between two chunks of a
# stream that has already started. 0 disables the respective ceiling; both can
# also be set in platform.json (llm.*) or per model.
#LLM_CONNECT_TIMEOUT_MS=10000
#LLM_STREAM_IDLE_TIMEOUT_MS=60000

# --- Proxy (if behind corporate proxy) ---
#HTTP_PROXY=http://proxy.example.com:8080
#HTTPS_PROXY=http://proxy.example.com:8080
#NO_PROXY=localhost,127.0.0.1,.local

# --- Authentication ---
# JWT Secret (OPTIONAL - auto-generated and persisted if not set)
# Only needed for multi-node deployments where all nodes must share the same secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#JWT_SECRET=your-secure-random-value

# --- OpenTelemetry (OPTIONAL) ---
# Standard OTEL_* env vars are honored at startup. Setting OTEL_EXPORTER_OTLP_ENDPOINT
# automatically switches the telemetry provider to "otlp" if the admin hasn't
# configured a different one in platform.json.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_HEADERS=
#OTEL_SERVICE_NAME=ihub-apps
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
