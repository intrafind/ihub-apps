  "stages": [{ "name": "smoke", "vus": 3, "rampSec": 10, "holdSec": 150 }],
  "gracefulStopSec": 180,
  "thinkTimeSec": [2, 5],
  "sessionPauseSec": [1, 3],
  "mix": {
    "chat": 30,
    "chatFile": 20,
    "projectChat": 25,
    "projectBuild": 15,
    "browse": 10,
    "inference": 0
  },
  "scenarios": {
    "chat": { "turns": [2, 3] },
    "chatFile": { "turns": [2, 2] },
    "projectChat": { "turns": [2, 3] },
    "projectBuild": {
      "files": [2, 3],
      "chatTurns": 1,
      "crawl": { "maxPages": 10, "maxDepth": 1, "addPages": 3, "maxConcurrent": 1 }
    }
  },
  "setup": { "sharedProjects": 2, "docsPerProject": 4 },
  "slo": { "ttftOverheadP95Ms": null, "workerCpuAvgPct": null, "eventLoopDelayMaxMs": null }
}
