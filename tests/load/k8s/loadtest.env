# Shared by setup and run jobs. Secrets (passwords, LLM key) live in the
# loadtest-secrets Secret, see README.
#
# Through the Service = iHub alone, for sizing (the default: runners in the cluster).
# Through an ingress (https://ihub-loadtest.example.com) = what users get (TLS, affinity,
# proxy buffering); also what a runner outside the cluster has to use.
LT_BASE_URL=http://ihub.ihub-loadtest.svc:3000
LT_PROFILE=capacity-stub
LT_RUN_ID=capacity-stub-run1
LT_SHARD_COUNT=8
# Kept on: k8s/collect.sh copies the shard files (reliable) and falls back to these log lines.
LT_RESULT_TO_STDOUT=1
LT_STUB_MODEL_URL=http://loadtest-stubs.ihub-loadtest.svc:8979
LT_STUB_STATS_URL=http://loadtest-stubs.ihub-loadtest.svc:8979/__stats
LT_LLM_URL=https://gpu-a.example.com
# Several GPUs, one model each (loadtest-gpu, -2, -3); replaces LT_LLM_URL:
# LT_LLM_URLS=https://gpu-a.example.com,https://gpu-b.example.com
LT_CRAWL_URL=http://loadtest-stubs:8980/docs/
LT_CRAWL_MAX_CONCURRENT=1
LT_EXPECTED_LLM_TTFT_MS=700
LT_TARGET_CONCURRENT_USERS=500
# Optional outside views (see README → Observability):
# vLLM metrics of every GPU are scraped automatically for loadtest-gpu runs.
# LT_PROM_URL=https://grafana.example.com/api/datasources/proxy/uid/<prometheus-uid>
# LT_PROM_IHUB_NAMESPACE=ihub
# LT_PROM_IHUB_POD_REGEX=ihub.*
# LT_PROM_GPU_SELECTOR=Hostname="gpu-a"
# (LT_PROM_TOKEN goes into the loadtest-secrets Secret)
