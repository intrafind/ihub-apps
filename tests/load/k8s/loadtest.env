# Shared by setup and run jobs. Secrets (passwords, LLM key) live in the
# loadtest-secrets Secret, see README.
#
# Through the ingress = what users get (TLS, affinity, proxy buffering).
# Through the Service (http://ihub.<ns>.svc:3000) = iHub alone, for sizing.
LT_BASE_URL=https://ihub-loadtest.example.intrafind.io
LT_PROFILE=capacity-stub
LT_RUN_ID=capacity-stub-run1
LT_SHARD_COUNT=4
LT_RESULT_TO_STDOUT=1
LT_STUB_MODEL_URL=http://loadtest-stubs.ihub-loadtest.svc:8979
LT_STUB_STATS_URL=http://loadtest-stubs.ihub-loadtest.svc:8979/__stats
LT_LLM_URL=https://gpu-01.local.intrafind.io
LT_CRAWL_URL=https://intrafind.com/de
LT_CRAWL_MAX_CONCURRENT=1
LT_EXPECTED_LLM_TTFT_MS=700
LT_TARGET_CONCURRENT_USERS=500
